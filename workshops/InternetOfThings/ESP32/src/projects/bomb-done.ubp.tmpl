module main
author Devoxx4Kids
version 1 0 
description '{{project.m2_done}}'
variables '{{var.danger}}' '{{var.playing}}' '{{var.mood}}' '{{var.busy}}' 

script 50 50 {
whenStarted
'{{var.playing}}' = (booleanConstant false)
'{{var.busy}}' = (booleanConstant false)
'[tft:clear]'
c2b_showBomb '{{menu.bomb_calm}}'
'[tft:text]' '{{screen.m2_touch}}' 10 210 (colorSwatch 255 255 255 255) 2 (booleanConstant false)
}

script 50 300 {
whenCondition (c2b_middleTouched)
if (not (v '{{var.busy}}')) {
  if (v '{{var.playing}}') {
    '{{var.playing}}' = (booleanConstant false)
    '{{var.busy}}' = (booleanConstant true)
    c2b_showBomb '{{menu.bomb_safe}}'
    c2b_bigText ('[data:join]' '{{screen.m2_safe}}' ' ' ((timer) / 1000) ' s') (colorSwatch 0 255 0 255)
    c2b_beep 1320 300
    '{{var.busy}}' = (booleanConstant false)
  } else {
    '{{var.danger}}' = 0
    '{{var.mood}}' = 0
    resetTimer
    '[tft:clear]'
    c2b_showBomb '{{menu.bomb_calm}}'
    c2b_dangerBar 0
    '{{var.playing}}' = (booleanConstant true)
  }
}
}

script 450 50 {
whenCondition (v '{{var.playing}}')
local 'j' (c2b_jolt)
if (j > 15) {
  '{{var.danger}}' = ((v '{{var.danger}}') + ((j - 15) / 2))
} (and (j < 10) ((v '{{var.danger}}') > 0)) {
  '{{var.danger}}' = ((v '{{var.danger}}') - 1)
}
if ((v '{{var.danger}}') >= 100) {
  '{{var.playing}}' = (booleanConstant false)
  '{{var.busy}}' = (booleanConstant true)
  c2b_showBomb '{{menu.bomb_explode}}'
  c2b_vibrate 800
  c2b_bigText '{{screen.m2_boom}}' (colorSwatch 255 0 0 255)
  '{{var.busy}}' = (booleanConstant false)
} ((v '{{var.danger}}') >= 50) {
  c2b_showBomb '{{menu.bomb_nervous}}'
  c2b_beep 880 40
  '{{var.mood}}' = 1
  c2b_dangerBar (v '{{var.danger}}')
} else {
  if ((v '{{var.mood}}') == 1) {
    c2b_showBomb '{{menu.bomb_calm}}'
    '{{var.mood}}' = 0
  }
  c2b_dangerBar (v '{{var.danger}}')
}
waitMillis 30
}


