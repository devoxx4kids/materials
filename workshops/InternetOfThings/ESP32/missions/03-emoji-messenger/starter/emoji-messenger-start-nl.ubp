module main
author Devoxx4Kids
version 1 0 
description 'Emoji-messenger - begin hier'
variables emojis choice myName 

script 50 50 {
whenStarted
comment 'Begin hier! Verander groepsnummer 1 in jullie tafelnummer. De emojilijst staat al klaar. Volg mission.md stap voor stap.'
'[net:ESPNowSetGroup]' 1
myName = 'Team 1'
emojis = ('[data:makeList]' ':-)' ':-D' ';-)' '<3' ':-O' ':-(' 'B-)' ':-P')
choice = 1
}


module Core2Buttons Input
author Devoxx4Kids
version 1 0 
depends Tone 
description 'Kindvriendelijke blokken voor de M5Stack Core2: de drie rode aanraakcirkels, schudden, trillen, piepen en grote tekst. Gemaakt voor de ESP32-workshop van Devoxx4Kids.'
variables _c2b_wasDown 

  spec 'r' 'c2b_leftTouched' 'linkerknop aangeraakt?'
  spec 'r' 'c2b_middleTouched' 'middelste knop aangeraakt?'
  spec 'r' 'c2b_rightTouched' 'rechterknop aangeraakt?'
  space
  spec 'r' 'c2b_shaken' 'bord geschud?'
  space
  spec ' ' 'c2b_vibrate' 'tril _ ms' 'num' 300
  spec ' ' 'c2b_beep' 'piep _ Hz gedurende _ ms' 'num num' 880 200
  spec ' ' 'c2b_bigText' 'toon grote tekst _ kleur _' 'str color' 'Hello!' 16777215
  space
  spec 'r' '_c2b_zone' '_c2b_zone'
  spec 'r' '_c2b_edge' '_c2b_edge _' 'num' 1
  spec ' ' '_c2b_flashOn' '_c2b_flashOn'
  spec ' ' '_c2b_flashOff' '_c2b_flashOff'

to '_c2b_zone' {
  comment 'Geeft 1, 2 of 3 als de linker, middelste of rechter rode cirkel onder het scherm wordt aangeraakt, anders 0. De cirkels zijn aanraakzones onder het 240 pixels hoge scherm.'
  if (not ('[tft:tftTouched]')) {
    return 0
  }
  if (('[tft:tftTouchY]') < 240) {
    return 0
  }
  local 'x' ('[tft:tftTouchX]')
  if (x < 107) {
    return 1
  }
  if (x < 214) {
    return 2
  }
  return 3
}

to '_c2b_edge' zone {
  comment 'Alleen waar op het moment dat een cirkel aangeraakt wordt: één aanraking is één gebeurtenis, ook als de vinger blijft liggen.'
  if (_c2b_wasDown == 0) {
    _c2b_wasDown = ('[data:makeList]' (booleanConstant false) (booleanConstant false) (booleanConstant false))
  }
  local 'down' (('_c2b_zone') == zone)
  local 'was' (at zone _c2b_wasDown)
  atPut zone _c2b_wasDown down
  return (and down (not was))
}

to c2b_leftTouched {
  return ('_c2b_edge' 1)
}

to c2b_middleTouched {
  return ('_c2b_edge' 2)
}

to c2b_rightTouched {
  return ('_c2b_edge' 3)
}

to c2b_shaken {
  comment 'De versnelling is ongeveer 100 als het bord stil ligt. Voor meer dan 140 moet je echt schudden.'
  return (('[sensors:acceleration]') > 140)
}

to c2b_vibrate ms {
  comment 'De trilmotor krijgt stroom van LDO3 van de AXP192-stroomchip (I2C-adres 52). Bit 3 (waarde 8) van register 18 zet hem aan en uit.'
  '_c2b_flashOn'
  local 'reg' (i2cGet 52 18)
  if (and (reg >= 0) (reg <= 255)) {
    local 'off' (reg - (8 * ((reg / 8) % 2)))
    i2cSet 52 18 (off + 8)
    waitMillis ms
    i2cSet 52 18 off
  } else {
    waitMillis ms
  }
  '_c2b_flashOff'
}

to c2b_beep frequency ms {
  '_c2b_flashOn'
  'play frequency' frequency ms
  '_c2b_flashOff'
}

to '_c2b_flashOn' {
  comment 'Tekent een geel kader rond het scherm zolang een piep of trilling duurt, zodat kinderen het zien, ook als de luidspreker of de motor stil blijft.'
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 255 220 0 255) (booleanConstant false)
  }
}

to '_c2b_flashOff' {
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 0 0 0 255) (booleanConstant false)
  }
}

to c2b_bigText text color {
  comment 'Wist het scherm en schrijft de tekst in het midden. Lange teksten worden kleiner zodat ze passen (een letter is 6 x 8 pixels op grootte 1).'
  text = ('[data:join]' '' text)
  local 'scale' 4
  if ((size text) > 13) {
    scale = 2
  }
  if ((size text) > 26) {
    scale = 1
  }
  local 'x' ((320 - ((size text) * (6 * scale))) / 2)
  if (x < 0) {
    x = 0
  }
  local 'y' ((240 - (8 * scale)) / 2)
  '[tft:clear]'
  '[tft:text]' text x y color scale (booleanConstant true)
}


module Tone Output
author MicroBlocks
version 1 11 
tags tone sound music audio note speaker 
choices tone_NoteName 'nt;c' 'nt;c#' 'nt;d' 'nt;d#' 'nt;e' 'nt;f' 'nt;f#' 'nt;g' 'nt;g#' 'nt;a' 'nt;a#' 'nt;b' 
description 'Audio tone generation. Make music with MicroBlocks!
'
variables _tonePin _toneInitalized _toneLoopOverhead _toneNoteNames _toneArezzoNotes _toneFrequencies 

  spec ' ' 'play tone' 'play note _ octave _ for _ ms' 'str.tone_NoteName num num' 'nt;c' 0 500
  spec ' ' 'playMIDIKey' 'play midi key _ for _ ms' 'num num' 60 500
  spec ' ' 'play frequency' 'play frequency _ for _ ms' 'num num' 261 500
  space
  spec ' ' 'startTone' 'start tone _ Hz' 'num' 440
  spec ' ' 'tone_startNote' 'start note _ octave _' 'str.tone_NoteName num' 'nt;c' 0
  spec ' ' 'tone_startMIDIKey' 'start midi key _' 'num' 60
  spec ' ' 'stopTone' 'stop tone'
  space
  spec ' ' 'attach buzzer to pin' 'attach buzzer to pin _' 'auto' ''
  space
  spec 'r' '_measureLoopOverhead' '_measureLoopOverhead'
  spec 'r' '_baseFreqForNote' '_baseFreqForNote _' 'auto' 'c'
  spec 'r' '_baseFreqForSemitone' '_baseFreqForSemitone _' 'num' 0
  spec ' ' '_toneLoop' '_toneLoop _ for _ ms' 'num num' 440000 100
  spec 'r' '_trimmedLowercase' '_trimmedLowercase _' 'str' 'A. b C...'
  spec ' ' '_tone init note names' '_tone init note names'
  spec ' ' '_arp play MIDI note' '_arp play MIDI note _ for _ on channel _ volume _' 'auto auto auto auto' 60 500 1 127

to '_arp play MIDI note' note ms c vol {
  playMIDIKey note ms
}

to '_baseFreqForNote' note {
  comment 'Return the frequency for the given note in the middle-C octave
scaled by 1000. For example, return 440000 (440Hz) for A.
Note names may be upper or lower case. Note names
may be followed by # for a sharp or b for a flat.'
  local 'normalized note' ('_trimmedLowercase' note)
  'normalized note' = (ifExpression ((at 1 (v 'normalized note')) == 'n') (v 'normalized note') ('[data:join]' 'nt;' (v 'normalized note')))
  '_tone init note names'
  if (('[data:find]' (v 'normalized note') _toneArezzoNotes) > 0) {
    return ('_baseFreqForSemitone' ('[data:find]' (v 'normalized note') _toneArezzoNotes))
  } else {
    return ('_baseFreqForSemitone' ('[data:find]' (v 'normalized note') _toneNoteNames))
  }
}

to '_baseFreqForSemitone' semitone {
  if (_toneFrequencies == 0) {_toneFrequencies = ('[data:makeList]' 261626 277183 293665 311127 329628 349228 369994 391995 415305 440000 466164 493883 246942 277183 277183 311127 311127 349228 329628 369994 369994 415305 415305 466164 466164 523252)}
  if (and (1 <= semitone) (semitone <= (size _toneFrequencies))) {
    return (at semitone _toneFrequencies)
  } else {
    comment 'Bad note name; return 10 Hz'
    return 10000
  }
}

to '_measureLoopOverhead' {
  comment 'Measure the loop overhead on this device'
  local 'halfCycle' 100
  local 'startT' (microsOp)
  repeat 100 {
    digitalWriteOp _tonePin false
    waitMicros halfCycle
    digitalWriteOp _tonePin false
    waitMicros halfCycle
  }
  local 'usecs' ((microsOp) - startT)
  return ((usecs - 20000) / 200)
}

to '_tone init note names' {
  if (_toneNoteNames == 0) {
    _toneNoteNames = ('[data:makeList]' 'nt;c' 'nt;c#' 'nt;d' 'nt;d#' 'nt;e' 'nt;f' 'nt;f#' 'nt;g' 'nt;g#' 'nt;a' 'nt;a#' 'nt;b' 'nt;c_' 'nt;db' 'nt;d_' 'nt;eb' 'nt;e_' 'nt;e#' 'nt;f_' 'nt;gb' 'nt;g_' 'nt;ab' 'nt;a_' 'nt;bb' 'nt;b_' 'nt;b#')
    _toneArezzoNotes = ('[data:makeList]' 'nt;do' 'nt;do#' 'nt;re' 'nt;re#' 'nt;mi' 'nt;fa' 'nt;fa#' 'nt;sol' 'nt;sol#' 'nt;la' 'nt;la#' 'nt;si' 'nt;do_' 'nt;dob' 'nt;re_' 'nt;reb' 'nt;mi_' 'nt;mi#' 'nt;fa_' 'nt;solb' 'nt;sol_' 'nt;lab' 'nt;la_' 'nt;sib' 'nt;si_' 'nt;si#')
  }
}

to '_toneLoop' scaledFreq ms {
  if (_toneInitalized == 0) {'attach buzzer to pin' ''}
  if ('[io:hasTone]') {
    '[io:playTone]' _tonePin (scaledFreq / 1000)
    waitMillis ms
    '[io:playTone]' _tonePin 0
  } else {
    local 'halfCycle' ((500000000 / scaledFreq) - _toneLoopOverhead)
    local 'cycles' ((ms * 500) / halfCycle)
    repeat cycles {
      digitalWriteOp _tonePin true
      waitMicros halfCycle
      digitalWriteOp _tonePin false
      waitMicros halfCycle
    }
  }
}

to '_trimmedLowercase' s {
  comment 'Return a copy of the given string without whitespace
or periods and all lowercase.'
  local 'result' (newList (size s))
  '[data:delete]' 'all' result
  for i (size s) {
    local 'ch' ('[data:unicodeAt]' i s)
    if (and (ch > 32) (ch != 46)) {
      if (and (65 <= ch) (ch <= 90)) {ch = (ch + 32)}
      '[data:addLast]' ch result
    }
  }
  return ('[data:unicodeString]' result)
}

to 'attach buzzer to pin' pinNumber {
  if (pinNumber == '') {
    comment 'Pin number not specified; use default pin for this device'
    if ((boardType) == 'Citilab ED1') {
      _tonePin = 26
    } ((boardType) == 'M5Stack-Core') {
      _tonePin = 25
    } ((boardType) == 'M5StickC') {
      _tonePin = 26
    } ((boardType) == 'Calliope') {
      digitalWriteOp 23 true
      digitalWriteOp 24 true
      _tonePin = 25
    } ((boardType) == 'D1-Mini') {
      _tonePin = 12
    } ((boardType) == 'CodingBox') {
      _tonePin = 32
    } else {
      _tonePin = -1
    }
  } else {
    _tonePin = pinNumber
  }
  _toneLoopOverhead = ('_measureLoopOverhead')
  _toneInitalized = (booleanConstant true)
}

to 'play frequency' freq ms {
  '_toneLoop' (freq * 1000) ms
}

to 'play tone' note octave ms {
  local 'freq' ('_baseFreqForNote' note)
  if (freq <= 10000) {
    waitMillis ms
    return 0
  }
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  '_toneLoop' freq ms
}

to playMIDIKey key ms {
  local 'freq' ('_baseFreqForSemitone' ((key % 12) + 1))
  local 'octave' ((key / 12) - 5)
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  '_toneLoop' freq ms
}

to startTone freq {
  if (_toneInitalized == 0) {'attach buzzer to pin' ''}
  if ('[io:hasTone]') {'[io:playTone]' _tonePin freq}
}

to stopTone {
  startTone 0
}

to tone_startMIDIKey key {
  local 'freq' ('_baseFreqForSemitone' ((key % 12) + 1))
  local 'octave' ((key / 12) - 5)
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  startTone ((freq + 500) / 1000)
}

to tone_startNote note octave {
  local 'freq' ('_baseFreqForNote' note)
  if (freq <= 10000) {
    return 0
  }
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  startTone ((freq + 500) / 1000)
}


module 'ESP Now' Comm
author MicroBlocks
version 1 3 
description 'Support for ESP Now peer-to-peer messaging for ESP boards.
Unencrypted messages are broadcast to all peers within range, so pairing is not necessary and there is no limit to the number of peers.

Delivery is unreliable; messages may be lost, especially when there is a lot of other WiFi and Bluetooth traffic in the 2.4 GHz band. The best channel is one without much traffic.

The "pair" blocks provide functionality similar to the various Radio Libraries with data transported via ESP Now messages.

When using WiFi and ESP Now at the same time, the ESP32 forces ESP Now to use the same channel as WiFi. The ESP8266 allows ESP Now and WiFi to use different channels.
'
variables _espNow_lastNumber _espNow_lastString 

  spec ' ' 'espNow_send_pair' 'espNow send pair _ = _' 'str num' 'light' 10
  spec 'r' 'espNow_receive_pair' 'espNow pair received?'
  spec 'r' 'espNow_last_number' 'espNow last number'
  spec 'r' 'espNow_last_string' 'espNow last string'
  space
  spec ' ' '[net:ESPNowSetGroup]' 'espNow set group _ (0-255)' 'num' 0
  spec 'r' '[net:ESPNowGroup]' 'espNow group'
  space
  advanced
  spec ' ' 'espNow_send' 'espNow send raw _' 'str' 'Hello, ESP Now!'
  spec 'r' '[net:ESPNowReceive]' 'espNow receive raw'
  space
  spec ' ' '[net:ESPNowSetChannel]' 'espNow set channel _' 'menu.range:1-13' 1
  spec 'r' '[net:ESPNowChannel]' 'espNow channel'

to espNow_last_number {
  return _espNow_lastNumber
}

to espNow_last_string {
  return _espNow_lastString
}

to espNow_receive_pair {
  comment 'Format of ESP Now "pair" messages:
	tag: ''NOW'' (3 bytes)
	separator: |
	number n as String (variable length)
	separator: |
	string data s (variable length)
Messages that are not in this format are discarded.'
  local 'msg' ('[net:ESPNowReceive]')
  if (or ((size msg) < 5) ('NOW' != ('[data:copyFromTo]' msg 1 3))) {
    return (booleanConstant false)
  }
  local 'parts' ('[data:split]' msg '|')
  if ((size parts) != 3) {
    return (booleanConstant false)
  }
  _espNow_lastNumber = ('[data:convertType]' (at 2 parts) 'number')
  _espNow_lastString = (at 3 parts)
  return (booleanConstant true)
}

to espNow_send msg {
  comment 'Send an uninterpreted string via ESP Now. Allows users to define their own protocols.'
  '[net:ESPNowSend]' ('[data:convertType]' msg 'string')
}

to espNow_send_pair s n {
  espNow_send ('[data:join]' 'NOW' '|' ('[data:toString]' n) '|' s)
}
