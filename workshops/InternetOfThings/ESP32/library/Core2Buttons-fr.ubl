module Core2Buttons Input
author Devoxx4Kids
version 1 0 
depends Tone 
description 'Des blocs simples pour la M5Stack Core2 : les trois cercles rouges tactiles, secouer, vibrer, biper et du grand texte. Créés pour l''atelier ESP32 de Devoxx4Kids.'
variables _c2b_wasDown _c2b_nervousFrame _c2b_palette 
choices c2b_bombMenu 'calme' 'nerveuse' 'explose' 'en sécurité'

  spec 'r' 'c2b_leftTouched' 'bouton gauche touché ?'
  spec 'r' 'c2b_middleTouched' 'bouton du milieu touché ?'
  spec 'r' 'c2b_rightTouched' 'bouton droit touché ?'
  space
  spec 'r' 'c2b_shaken' 'carte secouée ?'
  space
  spec ' ' 'c2b_vibrate' 'vibrer pendant _ ms' 'num' 300
  spec ' ' 'c2b_beep' 'bip _ Hz pendant _ ms' 'num num' 880 200
  spec ' ' 'c2b_bigText' 'afficher grand texte _ couleur _' 'str color' 'Hello!' 16777215
  space
  spec ' ' 'c2b_showBomb' 'afficher la bombe _' 'menu.c2b_bombMenu' 'calme'
  spec 'r' 'c2b_jolt' 'secousse'
  spec ' ' 'c2b_dangerBar' 'afficher la barre de danger _' 'num' 50
  space
  spec 'r' '_c2b_zone' '_c2b_zone'
  spec 'r' '_c2b_edge' '_c2b_edge _' 'num' 1
  spec ' ' '_c2b_flashOn' '_c2b_flashOn'
  spec ' ' '_c2b_flashOff' '_c2b_flashOff'
  spec ' ' '_c2b_drawFrame' '_c2b_drawFrame _ _' 'str num' 'bomb_calm_1.data' 140
  spec ' ' '_c2b_playSet' '_c2b_playSet _' 'str' 'explode'
  spec 'r' '_c2b_bombPalette' '_c2b_bombPalette'
  spec 'r' '_c2b_bombSet' '_c2b_bombSet _' 'str' 'calm'

to '_c2b_zone' {
  comment 'Renvoie 1, 2 ou 3 quand le cercle rouge de gauche, du milieu ou de droite sous l''écran est touché, sinon 0. Les cercles sont des zones tactiles sous l''écran de 240 pixels de haut.'
  if (not ('[tft:tftTouched]')) {
    return 0
  }
  if (('[tft:tftTouchY]') < 240) {
    return 0
  }
  local 'x' ('[tft:tftTouchX]')
  if (x < 107) {
    return 1
  }
  if (x < 214) {
    return 2
  }
  return 3
}

to '_c2b_edge' zone {
  comment 'Vrai seulement au moment où un cercle devient touché : un toucher = un événement, même si le doigt reste dessus.'
  if (_c2b_wasDown == 0) {
    _c2b_wasDown = ('[data:makeList]' (booleanConstant false) (booleanConstant false) (booleanConstant false))
  }
  local 'down' (('_c2b_zone') == zone)
  local 'was' (at zone _c2b_wasDown)
  atPut zone _c2b_wasDown down
  return (and down (not was))
}

to c2b_leftTouched {
  return ('_c2b_edge' 1)
}

to c2b_middleTouched {
  return ('_c2b_edge' 2)
}

to c2b_rightTouched {
  return ('_c2b_edge' 3)
}

to c2b_shaken {
  comment 'L''accélération vaut environ 100 quand la carte est posée. Il faut vraiment secouer pour dépasser 140.'
  return (('[sensors:acceleration]') > 140)
}

to c2b_vibrate ms {
  comment 'Allume et éteint le moteur de vibration avec le bloc setVibration du firmware MicroBlocks Devoxx4Kids pour la Core2 (puce d''alimentation AXP192, sortie LDO3).'
  '_c2b_flashOn'
  '[tft:setVibration]' (booleanConstant true)
  waitMillis ms
  '[tft:setVibration]' (booleanConstant false)
  '_c2b_flashOff'
}

to c2b_beep frequency ms {
  '_c2b_flashOn'
  'play frequency' frequency ms
  '_c2b_flashOff'
}

to '_c2b_flashOn' {
  comment 'Dessine un cadre jaune autour de l''écran pendant un bip ou une vibration, pour que les enfants le voient même si le haut-parleur ou le moteur reste muet.'
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 255 220 0 255) (booleanConstant false)
  }
}

to '_c2b_flashOff' {
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 0 0 0 255) (booleanConstant false)
  }
}

to c2b_bigText text color {
  comment 'Efface l''écran et écrit le texte au milieu. Les textes longs sont plus petits pour tenir à l''écran (une lettre fait 6 x 8 pixels en taille 1).'
  text = ('[data:join]' '' text)
  local 'scale' 4
  if ((size text) > 13) {
    scale = 2
  }
  if ((size text) > 26) {
    scale = 1
  }
  local 'x' ((320 - ((size text) * (6 * scale))) / 2)
  if (x < 0) {
    x = 0
  }
  local 'y' ((240 - (8 * scale)) / 2)
  '[tft:clear]'
  '[tft:text]' text x y color scale (booleanConstant true)
}

to c2b_showBomb state {
  comment 'Dessine la bombe (Noto Animated Emoji de Google, CC BY 4.0). Les images sont des fichiers sur la carte, installés avec le firmware de l''atelier. Nerveuse affiche l''image suivante à chaque fois ; explose et en sécurité jouent toute leur animation.'
  if (state == 'calme') {
    '_c2b_drawFrame' 'bomb_calm_1.data' (at 2 ('_c2b_bombSet' 'calm'))
  } (state == 'nerveuse') {
    local 'set' ('_c2b_bombSet' 'nervous')
    _c2b_nervousFrame = ((_c2b_nervousFrame % (at 1 set)) + 1)
    '_c2b_drawFrame' ('[data:join]' 'bomb_nervous_' _c2b_nervousFrame '.data') (at 2 set)
  } (state == 'explose') {
    '[tft:clear]'
    '_c2b_playSet' 'explode'
  } (state == 'en sécurité') {
    '[tft:clear]'
    '_c2b_playSet' 'safe'
  }
}

to '_c2b_playSet' name {
  local 'set' ('_c2b_bombSet' name)
  for i (at 1 set) {
    '_c2b_drawFrame' ('[data:join]' 'bomb_' name '_' i '.data') (at 2 set)
  }
}

to '_c2b_drawFrame' file size {
  if (_c2b_palette == 0) {
    _c2b_palette = ('_c2b_bombPalette')
  }
  local 'x' ((320 - size) / 2)
  local 'y' ((200 - size) / 2)
  '[file:open]' file
  repeat size {
    '[tft:pixelRow]' ('[file:readBytes]' size file) x y 1 _c2b_palette
    y += 1
  }
  '[file:close]' file
}

to c2b_jolt {
  comment 'La force avec laquelle la carte bouge en ce moment : 0 quand elle est immobile, plus quand on la secoue. C''est l''écart entre l''accélération et 100 (= 1 g).'
  return (absoluteValue (('[sensors:acceleration]') - 100))
}

to c2b_dangerBar value {
  comment 'Une barre en bas de l''écran : verte sous 50, orange à partir de 50, rouge à 100.'
  local 'v' value
  if (v < 0) {
    v = 0
  }
  if (v > 100) {
    v = 100
  }
  local 'w' ((v * 320) / 100)
  local 'color' (colorSwatch 0 200 0 255)
  if (v >= 50) {
    color = (colorSwatch 255 160 0 255)
  }
  if (v >= 100) {
    color = (colorSwatch 255 0 0 255)
  }
  '[tft:rect]' 0 224 w 16 color (booleanConstant true)
  '[tft:rect]' w 224 (320 - w) 16 (colorSwatch 40 40 40 255) (booleanConstant true)
}

to '_c2b_bombPalette' {
  comment 'Generated by tools/convert_images.py: 256 colours, 6 hex digits each.'
  local 'hex' ''
  local 'result' ('[data:makeList]')
  for i 256 {
    '[data:addLast]' (hexToInt ('[data:copyFromTo]' hex ((i * 6) - 5) (i * 6))) result
  }
  return result
}

to '_c2b_bombSet' name {
  comment 'Generated by tools/convert_images.py: frame count and size in pixels per set.'
  if (name == 'calm') {
    return ('[data:makeList]' 1 140)
  }
  if (name == 'nervous') {
    return ('[data:makeList]' 6 140)
  }
  if (name == 'explode') {
    return ('[data:makeList]' 8 200)
  }
  if (name == 'safe') {
    return ('[data:makeList]' 6 200)
  }
  return ('[data:makeList]' 0 0)
}
