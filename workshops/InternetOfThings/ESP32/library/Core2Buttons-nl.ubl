module Core2Buttons Input
author Devoxx4Kids
version 1 0 
depends Tone 
description 'Kindvriendelijke blokken voor de M5Stack Core2: de drie rode aanraakcirkels, schudden, trillen, piepen en grote tekst. Gemaakt voor de ESP32-workshop van Devoxx4Kids.'
variables _c2b_wasDown _c2b_nervousFrame _c2b_palette _c2b_openFile 
choices c2b_bombMenu 'kalm' 'nerveus' 'ontploft' 'veilig'

  spec 'r' 'c2b_leftTouched' 'linkerknop aangeraakt?'
  spec 'r' 'c2b_middleTouched' 'middelste knop aangeraakt?'
  spec 'r' 'c2b_rightTouched' 'rechterknop aangeraakt?'
  space
  spec 'r' 'c2b_shaken' 'bord geschud?'
  space
  spec ' ' 'c2b_vibrate' 'tril _ ms' 'num' 300
  spec ' ' 'c2b_beep' 'piep _ Hz gedurende _ ms' 'num num' 880 200
  spec ' ' 'c2b_bigText' 'toon grote tekst _ kleur _' 'str color' 'Hello!' 16777215
  space
  spec ' ' 'c2b_showBomb' 'toon bom _' 'menu.c2b_bombMenu' 'kalm'
  spec 'r' 'c2b_jolt' 'schok'
  spec ' ' 'c2b_dangerBar' 'toon gevarenbalk _' 'num' 50
  space
  spec 'r' '_c2b_zone' '_c2b_zone'
  spec 'r' '_c2b_edge' '_c2b_edge _' 'num' 1
  spec ' ' '_c2b_flashOn' '_c2b_flashOn'
  spec ' ' '_c2b_flashOff' '_c2b_flashOff'
  spec ' ' '_c2b_drawFrame' '_c2b_drawFrame _ _' 'str num' 'bomb_calm_1.data' 140
  spec ' ' '_c2b_playSet' '_c2b_playSet _' 'str' 'explode'
  spec ' ' '_c2b_loadPalette' '_c2b_loadPalette'
  spec 'r' '_c2b_bombSet' '_c2b_bombSet _' 'str' 'calm'

to '_c2b_zone' {
  comment 'Geeft 1, 2 of 3 als de linker, middelste of rechter rode cirkel onder het scherm wordt aangeraakt, anders 0. De cirkels zijn aanraakzones onder het 240 pixels hoge scherm.'
  if (not ('[tft:tftTouched]')) {
    return 0
  }
  if (('[tft:tftTouchY]') < 240) {
    return 0
  }
  local 'x' ('[tft:tftTouchX]')
  if (x < 107) {
    return 1
  }
  if (x < 214) {
    return 2
  }
  return 3
}

to '_c2b_edge' zone {
  comment 'Alleen waar op het moment dat een cirkel aangeraakt wordt: één aanraking is één gebeurtenis, ook als de vinger blijft liggen.'
  if (_c2b_wasDown == 0) {
    _c2b_wasDown = ('[data:makeList]' (booleanConstant false) (booleanConstant false) (booleanConstant false))
  }
  local 'down' (('_c2b_zone') == zone)
  local 'was' (at zone _c2b_wasDown)
  atPut zone _c2b_wasDown down
  return (and down (not was))
}

to c2b_leftTouched {
  return ('_c2b_edge' 1)
}

to c2b_middleTouched {
  return ('_c2b_edge' 2)
}

to c2b_rightTouched {
  return ('_c2b_edge' 3)
}

to c2b_shaken {
  comment 'De versnelling is ongeveer 100 als het bord stil ligt. Voor meer dan 140 moet je echt schudden.'
  return (('[sensors:acceleration]') > 140)
}

to c2b_vibrate ms {
  comment 'Zet de trilmotor aan en uit met het setVibration-blok van de Devoxx4Kids-MicroBlocks-firmware voor de Core2 (stroomchip AXP192, uitgang LDO3).'
  '_c2b_flashOn'
  '[tft:setVibration]' (booleanConstant true)
  waitMillis ms
  '[tft:setVibration]' (booleanConstant false)
  '_c2b_flashOff'
}

to c2b_beep frequency ms {
  '_c2b_flashOn'
  'play frequency' frequency ms
  '_c2b_flashOff'
}

to '_c2b_flashOn' {
  comment 'Tekent een geel kader rond het scherm zolang een piep of trilling duurt, zodat kinderen het zien, ook als de luidspreker of de motor stil blijft.'
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 255 220 0 255) (booleanConstant false)
  }
}

to '_c2b_flashOff' {
  for i 3 {
    '[tft:rect]' (i - 1) (i - 1) (322 - (2 * i)) (242 - (2 * i)) (colorSwatch 0 0 0 255) (booleanConstant false)
  }
}

to c2b_bigText text color {
  comment 'Wist het scherm en schrijft de tekst in het midden. Lange teksten worden kleiner zodat ze passen (een letter is 6 x 8 pixels op grootte 1).'
  text = ('[data:join]' '' text)
  local 'scale' 4
  if ((size text) > 13) {
    scale = 2
  }
  if ((size text) > 26) {
    scale = 1
  }
  local 'x' ((320 - ((size text) * (6 * scale))) / 2)
  if (x < 0) {
    x = 0
  }
  local 'y' ((240 - (8 * scale)) / 2)
  '[tft:clear]'
  '[tft:text]' text x y color scale (booleanConstant true)
}

to c2b_showBomb state {
  comment 'Tekent de bom (Noto Animated Emoji van Google, CC BY 4.0). De beelden zijn bestanden op het bord, geïnstalleerd met de workshopfirmware. Nerveus toont elke keer het volgende beeld; ontploft en veilig spelen hun hele animatie af.'
  if (state == 'kalm') {
    '_c2b_drawFrame' 'bomb_calm_1.data' (at 2 ('_c2b_bombSet' 'calm'))
  } (state == 'nerveus') {
    local 'set' ('_c2b_bombSet' 'nervous')
    _c2b_nervousFrame = ((_c2b_nervousFrame % (at 1 set)) + 1)
    '_c2b_drawFrame' ('[data:join]' 'bomb_nervous_' _c2b_nervousFrame '.data') (at 2 set)
  } (state == 'ontploft') {
    '[tft:clear]'
    'play frequency' 50 200
    '_c2b_playSet' 'explode'
  } (state == 'veilig') {
    '[tft:clear]'
    '_c2b_playSet' 'safe'
  }
}

to '_c2b_playSet' name {
  local 'set' ('_c2b_bombSet' name)
  for i (at 1 set) {
    '_c2b_drawFrame' ('[data:join]' 'bomb_' name '_' i '.data') (at 2 set)
    if (name == 'explode') {
      'play frequency' (random 30 90) 50
    }
  }
}

to '_c2b_loadPalette' {
  comment 'Leest de 256 beeldkleuren uit het bestand bomb_palette.data op het bord. Zonder dat bestand blijven de beelden zwart, maar het programma blijft lopen.'
  _c2b_palette = ('[data:makeList]' 0)
  '[file:open]' 'bomb_palette.data'
  local 'rgb' ('[file:readBytes]' 768 'bomb_palette.data')
  '[file:close]' 'bomb_palette.data'
  if ((size rgb) < 768) {
    return 0
  }
  _c2b_palette = ('[data:makeList]')
  for i 256 {
    local 'k' ((i * 3) - 2)
    '[data:addLast]' ((((at k rgb) * 65536) + ((at (k + 1) rgb) * 256)) + (at (k + 2) rgb)) _c2b_palette
  }
}

to '_c2b_drawFrame' file size {
  if (_c2b_palette == 0) {
    '_c2b_loadPalette'
  }
  if (_c2b_openFile != 0) {
    '[file:close]' _c2b_openFile
  }
  local 'x' ((320 - size) / 2)
  local 'y' ((200 - size) / 2)
  '[file:open]' file
  _c2b_openFile = file
  repeat size {
    '[tft:pixelRow]' ('[file:readBytes]' size file) x y 1 _c2b_palette
    y += 1
  }
  '[file:close]' file
  _c2b_openFile = 0
}

to c2b_jolt {
  comment 'Hoe hard het bord nu beweegt: 0 als het stil ligt, meer als je schudt. Het is het verschil tussen de versnelling en 100 (= 1 g).'
  return (absoluteValue (('[sensors:acceleration]') - 100))
}

to c2b_dangerBar value {
  comment 'Een balk onderaan het scherm: groen onder 50, oranje vanaf 50, rood bij 100.'
  local 'v' value
  if (v < 0) {
    v = 0
  }
  if (v > 100) {
    v = 100
  }
  local 'w' ((v * 320) / 100)
  local 'color' (colorSwatch 0 200 0 255)
  if (v >= 50) {
    color = (colorSwatch 255 160 0 255)
  }
  if (v >= 100) {
    color = (colorSwatch 255 0 0 255)
  }
  '[tft:rect]' 0 224 w 16 color (booleanConstant true)
  '[tft:rect]' w 224 (320 - w) 16 (colorSwatch 40 40 40 255) (booleanConstant true)
}

to '_c2b_bombSet' name {
  comment 'Generated by tools/convert_images.py: frame count and size in pixels per set.'
  if (name == 'calm') {
    return ('[data:makeList]' 1 140)
  }
  if (name == 'nervous') {
    return ('[data:makeList]' 6 140)
  }
  if (name == 'explode') {
    return ('[data:makeList]' 8 200)
  }
  if (name == 'safe') {
    return ('[data:makeList]' 6 200)
  }
  return ('[data:makeList]' 0 0)
}
