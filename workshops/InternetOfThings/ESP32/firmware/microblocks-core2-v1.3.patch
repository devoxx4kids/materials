+
+void tftShowLogo() {
+	// Devoxx4Kids workshop: draw the Devoxx4Kids logo at start-up. It stays on the
+	// screen until a program draws something.
+
+	if (!tft) return;
+	tft->fillScreen(WHITE);
+	int i = 0;
+	for (int row = 0; row < D4K_LOGO_H; row++) {
+		int col = 0;
+		while (col < D4K_LOGO_W) {
+			int count = d4kLogoRuns[i++];
+			int color = d4kLogoRuns[i++];
+			tft->drawFastHLine(D4K_LOGO_X + col, D4K_LOGO_Y + row, count, color);
+			col += count;
+		}
+	}
+	UPDATE_DISPLAY();
+}
